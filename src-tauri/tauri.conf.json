{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darkroom",
  "version": "0.2.24",
  "identifier": "com.nvisi.darkroom",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Darkroom",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MzkzQ0E1OUIyNTZCNDIKUldSQ2F5V2JwVHc1ZHJZS2wwODZsV3FNTnMxTTh1NW5jd3VCUE1aOXAvNEhxQ0gvcnJxWFNkTDYK",
      "endpoints": [
        "https://updates.nvisionfilms.com/darkroom/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
